{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "webrebol: evaluate a source text",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/bin/webrebol.mjs",
      "args": [
        "print [\"The result is\" 6 * 7] 1 + 2"
      ],
      "env": {
        "WEBREBOL_DISK": "${workspaceFolder}/disk"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "record: write the REBOL 2.7.8 results",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/bin/record.mjs",
      "console": "integratedTerminal"
    },
    {
      "name": "serve: the WebRebol page in Chrome",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/bin/serve.mjs",
      "env": {
        "PORT": "8017"
      },
      "console": "integratedTerminal",
      "serverReadyAction": {
        "action": "debugWithChrome",
        "pattern": "WebRebol page: (http://localhost:[0-9]+/examples/index.html)",
        "uriFormat": "%s",
        "webRoot": "${workspaceFolder}"
      }
    },
    {
      "name": "compare: the corpus scripts in REBOL and in WebRebol",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/bin/compare.mjs",
      "console": "integratedTerminal"
    },
    {
      "name": "conform: the public REBOL test suite in REBOL and in WebRebol",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/bin/conform.mjs",
      "console": "integratedTerminal"
    }
  ]
}
